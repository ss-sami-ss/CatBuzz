# Copy to .env.local for development (PowerShell: Copy-Item .env.example .env.local).
# Values below match compose.yaml and are local-only. Never put a real secret in this file (docs/13).

APP_ORIGIN=http://localhost:3000

# PostgreSQL 18 + PostGIS 3.7 (docker compose service "db")
DATABASE_URL=postgres://catbuzz:catbuzz-local-only@127.0.0.1:55432/catbuzz
DATABASE_URL_TEST=postgres://catbuzz:catbuzz-local-only@127.0.0.1:55432/catbuzz_test

# Redis for BullMQ queues and rate limits (service "redis")
REDIS_URL=redis://127.0.0.1:56379

# S3-compatible object storage (service "storage", SeaweedFS)
STORAGE_ENDPOINT=http://127.0.0.1:58333
STORAGE_REGION=us-east-1
STORAGE_BUCKET_PRIVATE=catbuzz-private
STORAGE_BUCKET_PUBLIC=catbuzz-public
STORAGE_ACCESS_KEY=catbuzz-local
STORAGE_SECRET_KEY=catbuzz-local-only-secret

# Generate locally, for example: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
# Signs opaque list cursors (src/server/http/cursor.ts).
CURSOR_SECRET=
REALTIME_SECRET=

# Providers stay empty until chosen (D04 email-first, D05 payment, D07 map tiles).
# Empty means the feature runs in a clearly labeled disabled/test mode, never a fake success.
# Activation email (D04). Local: Mailpit from compose; inbox at http://127.0.0.1:58025.
# Production: any SMTP provider reachable from Iran (D12) behind the same adapter.
EMAIL_SMTP_URL=smtp://127.0.0.1:51025
EMAIL_FROM=CatBuzz <no-reply@catbuzz.local>
EMAIL_PROVIDER_KEY=
SMS_PROVIDER_KEY=
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
NEXT_PUBLIC_MAP_STYLE_URL=

# Dev-only design samples in a production build (/sample). Leave unset in real deployments.
CATBUZZ_ENABLE_SAMPLES=
